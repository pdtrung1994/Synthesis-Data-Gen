// Experiment Flowchart
digraph {
	rankdir=TD size="10,14"
	node [fontname=Arial fontsize=12]
	edge [fontname=Arial fontsize=11]
	Start [label="Bắt đầu" shape=oval]
	Init [label="Nhập Dataset D và các tập tham số:
N, S, G, Phi_G, M" shape=parallelogram]
	Step1 [label="Bước 1: Chia Dataset D thành 10 folds
(Đảm bảo các mẫu cùng ID nằm trong cùng fold)" shape=box]
	LoopK [label="k = 1..10?" color="#d0a0b0" fillcolor="#f9f2f4" penwidth=2 shape=diamond style=filled]
	K_Init [label="Khởi tạo D_test = Fold(k)
và D_train_pool = D \ Fold(k)" shape=box]
	LoopN [label="N ∈ N?" color="#d0a0b0" fillcolor="#f9f2f4" penwidth=2 shape=diamond style=filled]
	LoopR [label="r = 1..10?" color="#d0a0b0" fillcolor="#f9f2f4" penwidth=2 shape=diamond style=filled]
	Sample [label="Bước 2.5: Lấy ngẫu nhiên N mẫu/class
từ D_train_pool → D_seed" shape=box]
	LoopConfig [label="Duyệt tổ hợp cấu hình (G, φ, S)?" color="#d0a0b0" fillcolor="#f9f2f4" penwidth=2 shape=diamond style=filled]
	Generate [label="Bước 3: Huấn luyện G(φ) trên D_seed.
Sinh dữ liệu tổng hợp → D_synth" shape=box]
	LoopM [label="M ∈ M?" color="#d0a0b0" fillcolor="#f9f2f4" penwidth=2 shape=diamond style=filled]
	GridSearch [label="Bước 4: Grid Search (5-fold Cross-Validation)
trên D_synth → Lấy theta_opt" shape=box]
	TrainM [label="Huấn luyện Classifier M
trên D_synth với tham số theta_opt" shape=box]
	Evaluate [label="Đánh giá M trên tập thực tế D_test
→ Lưu Score(k, N, r, G, S, φ, M)" shape=box]
	Step5 [label="Bước 5: Tổng hợp thống kê
Tính trung bình 100 lần (10 folds x 10 seeds)
→ Ma trận P" shape=box]
	Output [label="Trả về Ma trận P" shape=parallelogram]
	End [label="Kết thúc" shape=oval]
	Start -> Init
	Init -> Step1
	Step1 -> LoopK
	LoopK -> K_Init [label="k nhánh"]
	K_Init -> LoopN
	LoopN -> LoopR [label="N nhánh"]
	LoopR -> Sample [label="r nhánh"]
	Sample -> LoopConfig
	LoopConfig -> Generate [label="Từng tổ hợp cấu hình"]
	Generate -> LoopM
	LoopM -> GridSearch [label="M nhánh"]
	GridSearch -> TrainM
	TrainM -> Evaluate
	Evaluate -> LoopM
	LoopM -> LoopConfig [label="Hết M"]
	LoopConfig -> LoopR [label="Hết cấu hình"]
	LoopR -> LoopN [label="Hết r"]
	LoopN -> LoopK [label="Hết N"]
	LoopK -> Step5 [label="Hết k"]
	Step5 -> Output
	Output -> End
}
